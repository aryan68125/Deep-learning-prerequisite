    "def people_col_converter(cell):\n",
    "    if cell == \"n.a.\":\n",
    "        return \"Arvind Krishna\"\n",
    "    else:\n",
    "        return cell\n",
    "df_excel = pd.read_excel(\"test_converter.xlsx\",engine=\"openpyxl\",converters = {\n",
    "     \"people\" : people_col_converter\n",
    "})\n",
    "df_excel"
   ]
  },
